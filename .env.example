# Supabase
# The URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# The anon public key for your Supabase project
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# The service role key for your Supabase project (keep this secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application
# The base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
# Allowed email domains for sign-up, separated by commas (e.g. example.edu,student.example.edu)
ALLOWED_EMAIL_DOMAINS=amrita.edu

# AI / LLM
# The API key for the chosen LLM provider (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# The model name to use for the LLM provider
AI_MODEL_NAME=claude-3-5-haiku-20241022

# Shows one-click demo sign-in buttons on the sign-in page (seeded accounts only). Never enable in production.
NEXT_PUBLIC_DEMO_MODE=false
